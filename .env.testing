# Test environment — loaded automatically when APP_ENV=testing (see phpunit.xml).
# MUST point exclusively at the *_testing database. tests/bootstrap.php and
# Tests\TestCase refuse to run against any database not ending in "_testing".
APP_NAME=TypiCMS
APP_ENV=testing
APP_KEY=base64:kFQKe1pw3TsQuJYyh7smSAETklG8xwv9glE/hij6GK4=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=single

DB_CONNECTION=mysql
DB_HOST=mariadb-test
DB_PORT=3306
DB_DATABASE=akademija_testing
DB_USERNAME=akademija
DB_PASSWORD=akademija

BROADCAST_DRIVER=log
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

FILESYSTEM_DRIVER=public

MODEL_CACHE_ENABLED=true

MAIL_MAILER=array
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
