# Test server environment (docker-compose.test-server.yml, docker/test-server/README.md).
# PLACEHOLDERS ONLY. Copy to .env.test-server on the server (never commit it), chmod 600, and
# replace every <...>. Never production keys, never the production bucket or database.
# The same file is read by the app container (env_file) and by Compose for the db service.

# Image tag to run (e.g. the git commit the image was built from).
APP_IMAGE_TAG=<git short sha, e.g. e6866b8>

APP_NAME=TypiCMS
# DECISION PENDING (README "Open decision: APP_ENV and mix-manifest.json"): with APP_ENV=production
# the layouts call mix(), which needs public/mix-manifest.json — that file is not in git, so every
# page would answer 500. Until decided, use a non-production name (the layouts then use asset()).
APP_ENV=staging
# Generate once: echo "base64:$(openssl rand -base64 32)"
APP_KEY=<base64:...>
APP_DEBUG=false
# Reached through the SSH tunnel (ssh -L 8080:127.0.0.1:8080 ...).
APP_URL=http://localhost:8080

LOG_CHANNEL=single

# The db service of this project (separate MariaDB 10.11.19 container, no published port).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=akademija_test
DB_USERNAME=akademija_test
DB_PASSWORD=<random password>
# Only for the db service (created on first start) and the import; the app does not use it.
DB_ROOT_PASSWORD=<another random password>

BROADCAST_DRIVER=log
# Same as production (file, not taggable; UPGRADE_PLAN O1 / R11).
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MODEL_CACHE_ENABLED=true

# Never mailgun on the test server: the contact form sends to a real address (UPGRADE_PLAN §18.4 B).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=<test sender address, e.g. test-server@example.invalid>
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=

GMAPS_API_KEY=
WELCOME_MESSAGE_URL=

# A SEPARATE NON-PRODUCTION S3 bucket and an IAM user limited to that bucket (UPGRADE_PLAN O1 / O2):
# same bucket settings as production (Object Ownership / ACLs, Block Public Access).
FILESYSTEM_DRIVER=s3
AWS_ACCESS_KEY_ID=<test bucket access key id>
AWS_SECRET_ACCESS_KEY=<test bucket secret access key>
AWS_DEFAULT_REGION=<region of the test bucket>
AWS_BUCKET=<name of the test bucket>
# As in production: leave AWS_URL / AWS_ENDPOINT unset (commented out, not empty) unless
# production sets them (O2a).
#AWS_URL=<only if production sets AWS_URL>
#AWS_ENDPOINT=<only for a non-AWS S3 endpoint>
AWS_USE_PATH_STYLE_ENDPOINT=false
