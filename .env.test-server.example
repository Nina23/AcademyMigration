# Test server environment (docker-compose.test-server.yml, docker/test-server/README.md).
# PLACEHOLDERS ONLY. Copy to /opt/akademija-test/.env.test-server on the server (never commit it),
# chmod 600, and replace every <...>. Never production keys, never the production bucket or database.
# The same file is read by Compose (for the proxy and db settings) and by the app container.
# Put secret values in SINGLE quotes ('...'): Compose would otherwise treat a "$" in a value (bcrypt
# hashes, some passwords) as the start of a variable.

# Image tag to run (the git commit the image was built from, e.g. de3af64).
APP_IMAGE_TAG=<git short sha>

# HTTP Basic Auth in front of the whole site (the proxy). The hash is made on the server with
#   docker run --rm -it caddy:2.8.4-alpine caddy hash-password      (asks for the password twice)
BASIC_AUTH_USER=<shared user name for the testers>
BASIC_AUTH_HASH='<bcrypt hash printed by caddy hash-password, starts with $2a$>'

APP_NAME=TypiCMS
# Approved: staging (the layouts use asset(); APP_ENV=production would need public/mix-manifest.json,
# which is not in git — UPGRADE_PLAN O12).
APP_ENV=staging
# Generate once: echo "base64:$(openssl rand -base64 32)"
APP_KEY='<base64:...>'
APP_DEBUG=false
# The address the testers open (the proxy publishes port 8080). Plain HTTP: no Secure-only cookies
# (SESSION_SECURE_COOKIE stays unset).
APP_URL=http://<SERVER_IP>:8080

LOG_CHANNEL=single

# The db service of this project (separate MariaDB 10.11.19 container, no published port).
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=akademija_test
DB_USERNAME=akademija_test
DB_PASSWORD='<random password>'
# Only for the db service (created on first start) and the import; the app does not use it.
DB_ROOT_PASSWORD='<another random password>'

BROADCAST_DRIVER=log
# Same as production (file, not taggable; UPGRADE_PLAN O1 / R11).
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MODEL_CACHE_ENABLED=true

# Never mailgun on the test server: the contact form sends to a real address (UPGRADE_PLAN §18.4 B).
MAIL_MAILER=log
MAIL_FROM_ADDRESS=<test sender address, e.g. test-server@example.invalid>
MAIL_FROM_NAME="${APP_NAME}"
MAILGUN_DOMAIN=
MAILGUN_SECRET=

GMAPS_API_KEY=
WELCOME_MESSAGE_URL=

# FILES — for now the LOCAL disk, in the persistent storage volume (akademija-test_storage).
# No files are copied: existing images and documents of the copy do not display (README).
FILESYSTEM_DRIVER=public

# LATER: the separate NON-PRODUCTION S3 test bucket (README "Later: switch to the S3 test bucket").
# Then set FILESYSTEM_DRIVER=s3 and uncomment and fill these; the image is not rebuilt.
#AWS_ACCESS_KEY_ID='<test bucket access key id>'
#AWS_SECRET_ACCESS_KEY='<test bucket secret access key>'
#AWS_DEFAULT_REGION=<region of the test bucket>
#AWS_BUCKET=<name of the test bucket>
#AWS_USE_PATH_STYLE_ENDPOINT=false
# Leave unset (commented out, not empty) unless production sets them (UPGRADE_PLAN O2a):
#AWS_URL=<only if production sets AWS_URL>
#AWS_ENDPOINT=<only for a non-AWS S3 endpoint>
