* text=auto
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored
CHANGELOG.md export-ignore
# Pinned package copies must stay byte-identical to the original packages
packages/** -text
# Shell scripts (tools/) must keep LF line endings to run in bash
*.sh text eol=lf
# Test server files are used on Linux: LF in every checkout and in "git archive", also on Windows with
# core.autocrlf=true (a CRLF .env.test-server.example broke the prepare script on the server)
docker-compose.test-server.yml text eol=lf
.env.test-server.example text eol=lf
docker/test-server/** text eol=lf
tools/test-server/** text eol=lf
