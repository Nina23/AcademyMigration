{
    "name": "typicms/base",
    "type": "project",
    "description": "A multilingual CMS built with Laravel",
    "keywords": [
        "cms",
        "multilingual",
        "laravel",
        "typi"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Samuel De Backer",
            "email": "samuel@typidesign.be",
            "role": "Developer"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "packages/*/*"
        },
        {
            "type": "vcs",
            "url": "https://github.com/TypiCMS/Laravel-Sidebar.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "aws/aws-sdk-php": "3.337.3",
        "bkwld/croppa": "^8.0.1",
        "genealabs/laravel-model-caching": "^0.12.5",
        "guzzlehttp/guzzle": "^7.0.1",
        "laracasts/presenter": "^0.2.4",
        "laracasts/utilities": "^3.2",
        "laravel/framework": "^9.52",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "maatwebsite/laravel-sidebar": "1.1.6",
        "msurguy/honeypot": "~1.1.5",
        "spatie/eloquent-sortable": "^4.5",
        "spatie/laravel-permission": "^6.25",
        "spatie/laravel-query-builder": "^5.7",
        "spatie/laravel-translatable": "4.6.0",
        "symfony/http-client": "^6.4",
        "symfony/mailgun-mailer": "^6.4",
        "typicms/blocks": "8.0.0",
        "typicms/core": "8.0.11",
        "typicms/dashboard": "8.0.0",
        "typicms/history": "8.0.1",
        "typicms/laravel-translatable-bootforms": "5.0.0",
        "typicms/menus": "8.0.2",
        "typicms/nestablecollection": "1.1.20",
        "typicms/roles": "8.0.1",
        "typicms/search": "8.0.0",
        "typicms/settings": "8.0.0",
        "typicms/sitemap": "8.0.0",
        "typicms/translations": "8.0.0",
        "typicms/users": "8.0.6",
        "typidesign/laravel-artisan-translations": "~1.0.3",
        "ultrono/laravel-sitemap": "^9.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.5",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^6.4",
        "phpunit/phpunit": "^9.3",
        "spatie/laravel-ignition": "^1.7"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "TypiCMS\\Modules\\": "Modules/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan storage:link"
        ]
    }
}
