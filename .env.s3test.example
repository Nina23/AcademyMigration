# Local S3 test (MinIO) - UPGRADE_PLAN.md D8 / O1, tools/s3-test/README.md.
# Copy to .env.s3test (never committed) and replace every <placeholder>;
# tools/s3-test/setup.sh does this with random dummy values.
# MinIO only. NEVER put production AWS credentials, the production bucket
# or the production database here.
APP_NAME=TypiCMS
APP_ENV=local
APP_KEY=<base64 key, e.g. from: php artisan key:generate --show>
APP_DEBUG=false
APP_URL=http://localhost:8081

# stderr = "docker compose logs app-s3", so the dev log file is not mixed up.
LOG_CHANNEL=stderr

# Separate copy of the production dump on the dev "mariadb" server
# (never akademija or akademija_testing).
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=akademija_s3test
DB_USERNAME=akademija
DB_PASSWORD=akademija

BROADCAST_DRIVER=log
# array: the dev app and app-s3 share storage/framework/cache; the file cache
# would mix model-cache entries of akademija and akademija_s3test.
CACHE_DRIVER=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DRIVER=s3

MODEL_CACHE_ENABLED=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

# App user in MinIO (limited to the bucket, created by setup.sh).
AWS_ACCESS_KEY_ID=<dummy app access key>
AWS_SECRET_ACCESS_KEY=<dummy app secret key>
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=akademija-s3test
# MinIO shares the network namespace of app-s3, so localhost:9000 is MinIO
# both inside the container and on the host.
AWS_ENDPOINT=http://localhost:9000
AWS_URL=http://localhost:9000/akademija-s3test
AWS_USE_PATH_STYLE_ENDPOINT=true

# The Laravel 8 code (branch development) has no use_path_style_endpoint key,
# so its S3 client sends virtual-host requests (akademija-s3test.localhost:9000).
# MINIO_DOMAIN lets MinIO accept both styles (docker-compose.s3.yml maps the name).
MINIO_DOMAIN=localhost

# MinIO server root user (dummy) and the mc client alias "s3test".
MINIO_ROOT_USER=<dummy root user>
MINIO_ROOT_PASSWORD=<dummy root password>
MC_HOST_s3test=http://<dummy root user>:<dummy root password>@localhost:9000
